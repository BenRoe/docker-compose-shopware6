# ============================================
# SECRETS - Generate with: openssl rand -hex 16
# ============================================
APP_SECRET=your-generated-secret-here
INSTANCE_ID=your-generated-instance-id-here
DB_ROOT_PASSWORD=your-root-password-here
DB_PASSWORD=your-db-password-here
RABBITMQ_PASSWORD=your-rabbitmq-password-here

# ============================================
# DOMAIN
# ============================================
APP_URL=https://your-shop-domain.com

# ============================================
# SMTP (Port 465 with SSL)
# ============================================
# IMPORTANT: If your username/password contains special characters like @ # & % = + 
# you MUST URL-encode them:
#   @ becomes %40
#   # becomes %23
#   & becomes %26
#   % becomes %25
#   = becomes %3D
#   + becomes %2B
#   space becomes %20
# 
# Example: 
#   Password: Pass@word#123
#   Encoded:  Pass%40word%23123
#
# Format: smtp://username:36rOmIsTPAamP1xxb@mx.example.de:465?encryption=ssl
# ============================================
MAILER_DSN=smtp://shop@yourdomain.com:your-password@mx.example.de:465?encryption=ssl